# AuraSpend Secrets Template
# Copy this to secrets.properties and fill in your values.
# secrets.properties is gitignored — never commit real keys.

# ── Release signing ──────────────────────────────────────────────────────────
# Without these four values `assembleProdRelease` still succeeds but produces an
# UNSIGNED, uninstallable APK. Generate a keystore with:
#   keytool -genkey -v -keystore auraspend-release.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias auraspend
# Back the .jks file up somewhere safe: losing it means the app can never be updated
# on Play again.
KEYSTORE_PATH=auraspend-release.jks
KEYSTORE_PASSWORD=
KEY_ALIAS=auraspend
KEY_PASSWORD=

# Note: Google Drive backup needs no key here. It uses Google Sign-In, which
# matches the app's package id + signing certificate against the OAuth client
# registered in the Google Cloud project (see docs/privacy.html). Dev builds
# (id `.dev`, debug signing) get their own OAuth client entry if you want
# Drive sign-in to work there.
